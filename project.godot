; INANNA: SEVEN GATES
; Godot 4.x project configuration.
; Logical game space is 256x192 world units (16x12 tiles of 16x16).

config_version=5

[application]

config/name="INANNA: Seven Gates"
config/description="A Mesopotamian single-screen puzzle-platformer."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Settings="*res://src/core/settings.gd"
SaveGame="*res://src/core/save_game.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=256
window/size/viewport_height=192
window/size/window_width_override=1024
window/size/window_height_override=768
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation=1

